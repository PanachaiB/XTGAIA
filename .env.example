# =====================================================================
# XTGAIA System Environment Configuration
# Copy this file to .env and adjust variables as needed for local testing
# =====================================================================

# ---------------------------------------------------------------------
# Neo4j Graph Database (Person 1 & Persistence)
# ---------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xtgaia_dev_password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------
# TheHive Case Management & HITL Governance (Person 3)
# ---------------------------------------------------------------------
# Host-facing URLs (localhost). Docker's xtgaia-core swaps only the host part for the
# compose service name, so one .env serves host Python and Docker alike.
THEHIVE_ADMIN_USERNAME=admin@thehive.local
THEHIVE_ADMIN_PASSWORD=change-me
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=<generate-in-thehive-ui>
APPLICATION_SECRET=<64-hex-chars: python -c "import secrets;print(secrets.token_hex(32))">

# ---------------------------------------------------------------------
# Shuffle SOAR Integration (Person 3)
# ---------------------------------------------------------------------
SHUFFLE_BASE_URL=http://localhost:5001
SHUFFLE_API_KEY=<from-shuffle-ui>
# Create Webhook triggers in the Shuffle UI (http://localhost:3001); paste the URL or 'webhook_<id>'.
SHUFFLE_EXECUTION_WEBHOOK_URL=webhook_<execution-trigger-id>
SHUFFLE_ROLLBACK_WEBHOOK_URL=webhook_<rollback-trigger-id>

# ---------------------------------------------------------------------
# Model & Cache Storage Paths
# ---------------------------------------------------------------------
MODEL_CHECKPOINT_DIR=data/models/
LOG_DIR=runs/
DATA_DIR=data/

# ---------------------------------------------------------------------
# Role 3 Feedback / Rollback API (TheHive Rollback -> replay buffer)
# ---------------------------------------------------------------------
ROLLBACK_WEBHOOK_TOKEN=<random: python -c "import secrets;print(secrets.token_hex(32))">
ROLLBACK_API_PORT=8008
